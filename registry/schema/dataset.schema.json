{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lankadatalayer.org/registry/schema/dataset.schema.json",
  "title": "Lanka Data Layer dataset registry entry",
  "description": "One dataset we publish. File: registry/datasets/<id>.yaml; the file stem must equal `id`.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "description",
    "source_ids",
    "indicators",
    "time_coverage",
    "method",
    "limits",
    "publication_class"
  ],
  "properties": {
    "id": { "$ref": "#/$defs/slug" },
    "title": { "type": "string", "minLength": 3 },
    "description": { "type": "string", "minLength": 10 },
    "source_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/slug" },
      "description": "Source ids (registry/sources/<id>.yaml)."
    },
    "indicators": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/indicator" },
      "description": "Indicators this dataset publishes. May be empty for pure feature/boundary datasets."
    },
    "time_coverage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "from": { "$ref": "#/$defs/period" },
        "to": { "$ref": "#/$defs/period" }
      }
    },
    "method": { "type": "string", "minLength": 3 },
    "limits": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 3 },
      "description": "What this dataset cannot tell you. At least one entry is mandatory."
    },
    "enrichment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "derived_from": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/slug" }
        },
        "joins": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "aggregations": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "publication_class": {
      "enum": ["A", "B", "C"],
      "description": "A auto-publish, B human review of deterministic parse, C LLM-assisted with human sign-off."
    }
  },
  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$", "maxLength": 80 },
    "indicatorId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_]*(\\.[a-z0-9][a-z0-9_]*)*$",
      "maxLength": 120,
      "description": "Dotted lowercase id, globally unique across datasets (e.g. pop.total, wdi.ny_gdp_mktp_cd)."
    },
    "period": {
      "anyOf": [
        { "type": "string", "pattern": "^\\d{4}(-(Q[1-4]|\\d{2}(-\\d{2})?))?$" },
        { "type": "integer", "minimum": 1800, "maximum": 2200 }
      ],
      "description": "YYYY, YYYY-Qn, YYYY-MM or YYYY-MM-DD (a bare YAML year like 2024 is accepted)."
    },
    "geoLevel": {
      "enum": ["national", "adm1", "adm2", "adm3", "adm4", "point", "line", "polygon", "raster"]
    },
    "indicator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "unit", "geo_levels", "period_type"],
      "properties": {
        "id": { "$ref": "#/$defs/indicatorId" },
        "label": { "type": "string", "minLength": 2 },
        "unit": { "type": "string", "minLength": 1 },
        "dims": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "description": "Dimension names (e.g. sex, age, ethnicity)."
        },
        "geo_levels": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/geoLevel" }
        },
        "period_type": { "enum": ["year", "quarter", "month", "day", "snapshot"] },
        "upstream_id": {
          "type": "string",
          "minLength": 1,
          "description": "Optional identifier of this series at the source (e.g. World Bank code SP.POP.TOTL, a sheet column key)."
        }
      }
    }
  }
}
