          "classes": 3,
          "method": "quantile"
        },
        "scale_sensitivity": [
          3,
          4
        ]
      }
    },
    "zone": {
      "spec": "ldl-analysis/1",
      "method": "group_compare",
      "support": {
        "kind": "points",
        "source": "listings"
      },
      "variables": {
        "y": {
          "field": "price_per_perch",
          "transform": "log"
        }
      },
      "params": {
        "zone": {
          "source": "flood",
          "where": {
            "op": ">=",
            "args": [
              {
                "property": "value"
              },
              0.15
            ]
          }
        },
        "rings_m": [
          0,
          250,
          500
        ],
        "compare": "inside_vs_ring",
        "within_groups": {
          "level": 3
        },
        "tests": [
          "welch",
          "mann_whitney"
        ],
        "bootstrap": 2000
      }
    }
