{
  "name": "@geopub/foundry",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Offline ETL pipeline: fetches sources, normalizes into a p-code-keyed schema, emits geopub.sqlite + manifest.json",
