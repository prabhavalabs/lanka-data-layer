# Copy to infra/v2/.env (gitignored) and set real values.
POSTGRES_DB=lanka
POSTGRES_USER=lanka
POSTGRES_PASSWORD=change-me
# Host port (always bound to 127.0.0.1).
LANKA_PG_PORT=55432
# Override only to use another build of the same PostGIS recipe.
# POSTGIS_IMAGE=imresamu/postgis:18-3.6.1-trixie

# ── engine (lanka CLI / server) — read from the process environment ────────
# DATABASE_URL=postgres://lanka:change-me@127.0.0.1:55432/lanka
# LANKA_DATA_DIR=./data/v2              # raw archive, content-addressed by sha256
# LANKA_REGISTRY_DIR=./registry
# LANKA_BIND=127.0.0.1:8601
# LANKA_ALERT_WEBHOOK=                  # POST JSON on run failure (ntfy / Slack / Matrix hook)
# LANKA_HEARTBEAT_URL=                  # external dead-man's-switch ping (healthchecks-style)
# RUST_LOG=info,lanka=debug
