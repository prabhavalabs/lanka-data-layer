# Copy to infra/v2/.env (gitignored; on the VPS: /etc/lanka/v2.env, root 0600) and set real values.
POSTGRES_DB=lanka
POSTGRES_USER=lanka
POSTGRES_PASSWORD=change-me
# Host port (always bound to 127.0.0.1).
LANKA_PG_PORT=55432
# Override only to use another build of the same PostGIS recipe.
# POSTGIS_IMAGE=imresamu/postgis:18-3.6.1-trixie

# ── application roles (05 §7); `migrate` sets these passwords ───────────────
LANKA_API_PASSWORD=change-me-api
LANKA_INGEST_PASSWORD=change-me-ingest
# LANKA_RECIPE_PASSWORD=

# ── engine containers ────────────────────────────────────────────────────────
# LANKA_IMAGE=ghcr.io/prabhavalabs/lanka:<tag>   # default: lanka:dev built from engine/
# LANKA_GIT_REV=<git sha>
LANKA_SERVE_PORT=8601            # blue (127.0.0.1 only)
LANKA_SERVE_GREEN_PORT=8611      # green, used by deploy.sh
# Host paths (production defaults shown); LANKA_REPO_DIR holds registry/ and country/.
# LANKA_STORE_HOST=/srv/lanka/store
# LANKA_INPUTS_HOST=/srv/lanka/inputs
# LANKA_REPO_DIR=/srv/lanka/repo
# LANKA_WORKER_SLOTS=4
# LANKA_TRAIN_AT=20:30            # daily release train, UTC (02:00 Asia/Colombo)
# LANKA_LIVE_TRAINS=true          # intraday trains (≤ 1/h) for `live` datasets
# LANKA_LOCAL_INPUTS=hdx-cod-ab-lka=/inputs/layers

# ── engine on the host (lanka CLI) — read from the process environment ──────
# DATABASE_URL=postgres://lanka:change-me@127.0.0.1:55432/lanka
# LANKA_STORE_DIR=./data/v2
# LANKA_REGISTRY_DIR=./registry
# LANKA_BIND=127.0.0.1:8601
# RUST_LOG=info,lanka=debug
